<?xml version="1.0"?>
<data_managers>
    <data_manager tool_file="data_manager/data_manager_ncbi_rankedlineage.xml"
                  id="data_manager_ednaflow_lca_taxonomy">
        <data_table name="ednaflow_lca_taxonomy">
            <output>
                <column name="value" />
                <column name="name" />
                <column name="date" />
                <column name="sha256" />
                <column name="path" output_ref="out_file">
                    <move type="file">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">ednaflow_lca_taxonomy/${value}/rankedlineage.dmp</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/ednaflow_lca_taxonomy/${value}/rankedlineage.dmp</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>
